# Server
PORT=4000
NODE_ENV=development
APP_NAME=klasee-api

# Frontend (must match NEXT_PUBLIC_APP_URL in web/.env)
FRONTEND_URL=http://localhost:3000

# MongoDB — required
MONGODB_URI=mongodb://localhost:27017
DB_NAME=klasee

# Security
API_KEY=
JWT_SECRET=change-me-min-32-chars-in-production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# Better Auth — required in production (min 32 chars)
BETTER_AUTH_SECRET=dev-better-auth-secret-min-32-chars
BETTER_AUTH_URL=http://localhost:4000
BETTER_AUTH_API_KEY=

# Google OAuth + Drive (required for Drive integration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email via Resend (optional — auth emails only for MVP)
RESEND_API_KEY=

# Logging
LOG_LEVEL=debug
LOG_DIR=./logs
